{
  "name": "site_exoleaders",
  "description": "Exo Leaders static website",
  "version": "1.0.0",
  "private": true,
  "keywords": [
    "gatsby"
  ],
  "license": "MIT",
  "main": "n/a",
  "scripts": {
    "build": "gatsby build",
    "clean": "rimraf public",
    "deploy": "gatsby build; cd public; now --name website-exoleaders",
    "dev": "gatsby develop",
    "now-build": "npm run build",
    "format": "prettier --semi --write \"src/**/*.{ts,tsx,md}\"",
    "lint": "tslint 'src/**/*.{ts,tsx}' -p tsconfig.json",
    "start": "npm run dev",
    "test": "npm run type-check && npm run lint",
    "type-check": "tsc",
    "deploy:gh-pages": "gatsby build --prefix-paths && gh-pages -d public"
  },
  "engines": {
    "node": ">=18.0.0 <26"
  },
  "dependencies": {
    "@emotion/react": "11.14.0",
    "@emotion/styled": "11.14.1",
    "classnames": "2.5.1",
    "form-serialize": "0.7.2",
    "gatsby": "5.16.1",
    "gatsby-image": "3.11.0",
    "gatsby-plugin-canonical-urls": "5.16.0",
    "gatsby-plugin-emotion": "8.16.0",
    "gatsby-plugin-google-analytics": "5.16.0",
    "gatsby-plugin-purgecss": "6.2.1",
    "gatsby-plugin-react-helmet": "6.16.0",
    "gatsby-plugin-sharp": "5.16.0",
    "gatsby-plugin-typescript": "5.16.0",
    "gatsby-remark-copy-linked-files": "6.16.0",
    "gatsby-remark-images": "7.16.0",
    "gatsby-remark-prismjs": "7.16.0",
    "gatsby-remark-responsive-iframe": "6.16.0",
    "gatsby-remark-smartypants": "6.16.0",
    "gatsby-source-filesystem": "5.16.0",
    "gatsby-transformer-json": "5.16.0",
    "gatsby-transformer-remark": "6.16.0",
    "gatsby-transformer-sharp": "5.16.0",
    "jsonp": "0.2.1",
    "modern-normalize": "3.0.1",
    "normalize.css": "8.0.1",
    "polished": "4.3.1",
    "prism-themes": "1.9.0",
    "prismjs": "1.30.0",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-helmet": "6.1.0",
    "react-hotjar": "6.3.1",
    "typescript": "6.0.2"
  },
  "devDependencies": {
    "@types/classnames": "2.3.4",
    "@types/form-serialize": "0.7.4",
    "@types/node": "25.6.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@types/react-helmet": "6.1.11",
    "gatsby-plugin-hotjar": "1.2.1",
    "gh-pages": "6.3.0",
    "prettier": "2.8.8",
    "rimraf": "6.1.3",
    "tslint": "5.20.1",
    "tslint-config-blvd": "1.2.1",
    "tslint-config-prettier": "1.18.0",
    "tslint-plugin-prettier": "2.3.0"
  }
}
